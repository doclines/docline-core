{
  "name": "create-docline",
  "version": "1.1.0",
  "description": "OpenSourceDocs Documentation Template",
  "type": "module",
  "files": [
    "docs.schema.json",
    "public",
    "scripts",
    "src",
    "index.html",
    "vite.config.js",
    "tailwind.config.js",
    "postcss.config.js",
    "README.md"
  ],
  "bin": {
    "docline": "scripts/docline-cli.mjs",
    "create-docline": "scripts/docline-cli.mjs"
  },
  "scripts": {
    "new": "node scripts/scaffold-template.mjs",
    "docs:compile": "node scripts/build-docline-content.mjs",
    "start": "npm run dev",
    "dev": "npm run docs:compile && vite",
    "build": "npm run docs:compile && vite build",
    "build:pages": "npm run docs:compile && vite build",
    "a11y": "npm run build && node scripts/a11y-docline.mjs",
    "export": "npm run build && node scripts/export-docline.mjs",
    "rename-page": "node scripts/rename-docline-page.mjs",
    "import:page": "node scripts/import-doc-page.mjs",
    "check": "npm run validate && npm run broken-links",
    "validate": "npm run docs:compile && node scripts/validate-docline.mjs",
    "broken-links": "npm run docs:compile && node scripts/check-docline-links.mjs --check-anchors",
    "broken-links:external": "npm run docs:compile && node scripts/check-docline-links.mjs --check-anchors --check-external",
    "readme:capture": "npm run build && node scripts/capture-readme-assets.mjs",
    "preview": "vite preview",
    "scaffold:starter": "node scripts/scaffold-template.mjs"
  },
  "keywords": [
    "docline",
    "create-docline",
    "documentation",
    "documentation-template",
    "documentation-generator",
    "developer-docs",
    "developer-portal",
    "api-docs",
    "api-documentation",
    "knowledge-base",
    "help-center",
    "docs-as-code",
    "technical-writing",
    "content-platform",
    "content-driven",
    "docs",
    "mdx-docs",
    "mdx",
    "markdown",
    "static-site",
    "static-docs",
    "static-site-generator",
    "ssg",
    "documentation-site",
    "developer-experience",
    "opensource-docs",
    "self-hosted-docs",
    "vite",
    "react",
    "generator"
  ],
  "author": "chinna NJ",
  "license": "MIT",
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "dompurify": "^3.4.11",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "marked": "^18.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.55.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.12"
  }
}
